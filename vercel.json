{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/tse/:path*",
      "destination": "https://resultados.tse.jus.br/oficial/:path*"
    },
    {
      "source": "/ibge/:path*",
      "destination": "https://servicodados.ibge.gov.br/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/tse/:path*",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=5, stale-while-revalidate=10"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600"
        }
      ]
    },
    {
      "source": "/ibge/:path*",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=3600"
        }
      ]
    }
  ]
}