{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/tse/:path*", "destination": "https://resultados.tse.jus.br/oficial/:path*" }
  ],
  "headers": [
    {
      "source": "/tse/:path*",
      "headers": [
        { "key": "CDN-Cache-Control", "value": "max-age=15, stale-while-revalidate=30" },
        { "key": "Cache-Control", "value": "public, max-age=10" }
      ]
    },
    {
      "source": "/data/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
    }
  ]
}
